# Canonical public URL used in metadata, links, robots.txt, and sitemap.xml.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Leave empty when the browser should call the Next.js /api proxy.
NEXT_PUBLIC_API_BASE_URL=
# HTTPS endpoint that accepts contact form JSON and delivers it to support.
NEXT_PUBLIC_CONTACT_ENDPOINT=
# Private server-only URL used by Next.js to proxy API requests to Express.
BACKEND_URL=http://localhost:5001
